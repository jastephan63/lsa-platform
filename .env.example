# Copy to .env and adjust. The .env file is gitignored; nothing here is a real
# credential. Every component reads its configuration from the environment.

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lsa
POSTGRES_USER=lsa_admin
POSTGRES_PASSWORD=change-me-locally

# Read-only role used by the API service (least privilege; created by migrations)
LSA_API_DB_USER=lsa_api
LSA_API_DB_PASSWORD=change-me-locally-too

# Analyst role used by the R analysis jobs (reads pseudonymised microdata)
LSA_ANALYST_DB_USER=lsa_analyst
LSA_ANALYST_DB_PASSWORD=change-me-as-well

# API service
LSA_API_HOST=0.0.0.0
LSA_API_PORT=8000
LSA_LOG_LEVEL=INFO

# Minimum cell size below which aggregates are suppressed (see docs/datenschutz.md)
LSA_MIN_CELL_SIZE=10

# Bearer token for the restricted analyst tier of the API (leave set to
# enable it; the endpoint answers 503 when unset)
LSA_ANALYST_API_TOKEN=change-this-token
